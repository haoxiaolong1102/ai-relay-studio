#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""media_ask <文件> "<问题>" [--deep] [--route agy|api] [--queue]
请 Gemini 听/看一个媒体文件。纯音频走 Antigravity 订阅，视频走 gemini-eyes（API）。"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from relaylib import media  # noqa: E402
from relaylib.common import RelayError  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(media.cli(sys.argv[1:]))
    except RelayError as e:
        print("没做成：%s" % e)
        sys.exit(1)
