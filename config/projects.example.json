{
  "live_enabled": true,
  "holders_copy": "~/.claude/relay-holders.json",
  "snapshots_dir": "~/ai-relay-snapshots",
  "codex": {
    "bin": "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
    "model": "gpt-6.1-sol",
    "effort": "medium",
    "max_segments": 4,
    "segment_timeout_min": 20,
    "total_timeout_min": 90,
    "network_access": false,
    "sandbox": "workspace-write"
  },
  "antigravity": {
    "bin": "~/.local/bin/agy",
    "model": "gemini-4-argon-medium",
    "permissions": "edits",
    "max_segments": 4,
    "segment_timeout_min": 20,
    "total_timeout_min": 90
  },
  "doubao": {
    "api_url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
    "api_key": "",
    "model": "doubao-seed-1-6-250615",
    "web_url": "https://www.doubao.com/chat/",
    "app_path": "/Applications/豆包浏览器.app"
  },
  "deepseek": {
    "api_url": "https://api.deepseek.com/chat/completions",
    "api_key": "",
    "model": "deepseek-chat",
    "web_url": "https://chat.deepseek.com/",
    "app_path": ""
  },
  "git": {
    "isolated_commit": true,
    "push": false,
    "remote": "origin",
    "max_file_mb": 50
  },
  "projects": {
    "demo": {
      "name": "My project",
      "path": "/absolute/path/to/your/project",
      "raw_dirs": ["raw"],
      "test_cmd": ["/usr/bin/python3", "-m", "unittest", "-q"],
      "readonly_mcp": []
    }
  }
}
